# Copy to backend/.env for local overrides. Never commit real keys.
SILO_DATABASE_URL=sqlite:///./silo.db
# SILO_DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/silo
SILO_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
SILO_RATE_LIMIT_PER_MINUTE=30
SILO_URL_FETCH_ENABLED=true
SILO_NLP_ENGINE=auto            # auto | spacy | rules

# Optional live civic data (free keys from https://api.data.gov/signup/)
SILO_LIVE_DATA_ENABLED=false
SILO_FEC_API_KEY=
SILO_CONGRESS_API_KEY=

# Frontend (frontend/.env) — only needed when the API is on another origin
# VITE_API_BASE_URL=https://silo-api.onrender.com
